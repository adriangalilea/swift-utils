{
  "sourceLanguage": "en",
  "strings": {
    "%@ belongs to macOS system-wide": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pertenece a macOS en todo el sistema"
          }
        }
      }
    },
    "%@ is already %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya está ocupado por %2$@"
          }
        }
      }
    },
    "Another app owns this system-wide right now - it won't fire": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app posee este atajo en todo el sistema ahora mismo: no funcionará"
          }
        }
      }
    },
    "Filter actions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrar acciones"
          }
        }
      }
    },
    "From any app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde cualquier app"
          }
        }
      }
    },
    "In-app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la app"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        }
      }
    },
    "Remove this shortcut": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar este atajo"
          }
        }
      }
    },
    "Reset to defaults": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer valores por defecto"
          }
        }
      }
    },
    "Restore Defaults": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar valores"
          }
        }
      }
    },
    "System-wide": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En todo el sistema"
          }
        }
      }
    },
    "System-wide - works even when this app is in the background": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En todo el sistema: funciona aunque la app esté en segundo plano"
          }
        }
      }
    },
    "System-wide shortcuts need ⌘, ⌥, or ⌃": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de sistema necesitan ⌘, ⌥ o ⌃"
          }
        }
      }
    },
    "Works while this app is frontmost": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona mientras esta app está en primer plano"
          }
        }
      }
    },
    "press keys…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pulsa teclas…"
          }
        }
