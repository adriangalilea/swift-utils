+                    Image(
+                        systemName: standing.grade == .good ? "checkmark.circle.fill" : grant.symbol
+                    )
+                    .font(.system(size: 48))
+                    .foregroundStyle(
+                        standing.grade == .good ? AnyShapeStyle(.green) : AnyShapeStyle(.secondary))
