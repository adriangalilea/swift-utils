diff --git a/Sources/PermissionGrants/Claim.swift b/Sources/PermissionGrants/Claim.swift
new file mode 100644
index 0000000..09d8110
--- /dev/null
+++ b/Sources/PermissionGrants/Claim.swift
@@ -0,0 +1,179 @@
+import Foundation
+import os
+
+/// The claim/proof machine: THE authority on a capability whose system
+/// readout can lie (an FSKit module the settings plist says is enabled
+/// while fskitd serves nothing; any registry that mirrors intent, not
+/// reality). One instance per capability; every surface renders from
+/// `verdict` (through the owning grant's standing), every real attempt is
+/// REPORTED here, and any disagreement between prediction and reality is
+/// a first-class journaled CONTRADICTION - the debugging surface this
+/// machine exists for.
+///
+/// Epistemics, deliberately explicit:
+/// - INTENT is the user's switch as the CONSUMER read it: on, off with the
+///   reason the consumer knows (turned off; not even registered), or
+///   unreadable - the system hides the switch - which is not off.
+/// - PROOF is a real outcome: the only witness that cannot lie. A past
+///   success is a witness of the PAST; only a capability seen live RIGHT
+///   NOW speaks for the present when the switch can't be read.
+/// - The verdict reconciles claim with evidence. It may be WRONG - and
+///   when reality says so, the machine records the contradiction and
+///   corrects itself. Never silently.
+///
+/// Knowledge sits where it lives: the consumer names why a switch is off
+/// (it read the registry), the machine names only what IT learned - a
+/// failure under a switch that claims on (`whenFailing`).
+///
+/// An unproven claim is NOT a problem: the owning grant renders both
+/// `.capable` and `.unproven` as `.good` (the switch is readable and on)
+/// - proof is journal detail, never UI divergence. `.unknown` renders as
+/// exactly that, never as good.
+/// Isolation is the consumer's convention (main-thread by convention
+/// matches an unannotated app model; annotating @MainActor here would
+/// only manufacture isolation errors, not safety).
+/// Nested in `PermissionGrant`: "Claim" is apps' own word too (awake's
+/// sessions are Claims). A custom grant renders its verdict.
+extension PermissionGrant {
+    @Observable
+    public final class Claim<Reason: Equatable> {
+        public enum Intent: Equatable, CustomStringConvertible {
+            /// The switch reads on.
+            case on
+            /// The switch reads off, and the consumer knows why.
+            case off(Reason)
+            /// The system hides the switch from the app.
+            case unreadable
+
+            public var description: String {
+                switch self {
+                case .on: "on"
+                case .off(let why): "off(\(why))"
+                case .unreadable: "unreadable"
+                }
+            }
+        }
+
+        public enum Verdict: Equatable, CustomStringConvertible {
+            /// The switch is on and a real success proved it - or the
+            /// capability is live right now. Capable until reality says otherwise.
+            case capable
+            /// Intent says on; nothing has confirmed yet. Attempts proceed -
+            /// the first success IS the confirmation.
+            case unproven
+            /// The switch can't be read and nothing is live to vouch for it.
+            /// Attempts proceed; nothing is claimed either way.
+            case unknown
+            /// We believe an attempt cannot succeed now, and why. A belief:
+            /// the user may try anyway, and a success is a recorded
+            /// contradiction that flips the verdict.
+            case impossible(Reason)
+
+            public var description: String {
+                switch self {
+                case .capable: "capable"
+                case .unproven: "unproven"
+                case .unknown: "unknown"
+                case .impossible(let why): "impossible(\(why))"
+                }
+            }
+        }
+
+        public enum Outcome: CustomStringConvertible {
+            /// A real attempt succeeded.
+            case succeeded
+            /// The capability was seen ALREADY working (e.g. a live mount in
+            /// the mount table) without this process attempting anything.
+            case witnessed
+            case failed(String)
+
+            public var description: String {
+                switch self {
+                case .succeeded: "succeeded"
+                case .witnessed: "witnessed"
+                case .failed(let detail): "failed(\(detail))"
+                }
+            }
+        }
+
+        public private(set) var verdict: Verdict = .unproven
+        /// The instrument: every transition and every contradiction, oldest
+        /// first, capped. Render it verbatim in a debug surface.
+        public private(set) var journal: [(at: Date, line: String)] = []
+
+        private let whenFailing: Reason
+        private let log: Logger
+        private var proven = false
+        private var lastFailure: String?
+
+        /// `whenFailing` is the verdict's reason while the switch claims on
+        /// (or can't be read) but the last attempt failed: the system is not
+        /// serving what the switch claims.
+        public init(whenFailing: Reason, log: Logger) {
+            self.whenFailing = whenFailing
+            self.log = log
+        }
+
+        /// Re-derive the verdict from intent plus everything reality has
+        /// said. Call from the app's reconcile path (app-active + relevant
+        /// system events - the liveness pattern) with the switch's current
+        /// read and whether the capability is live right now.
+        public func evaluate(intent: Intent, live: Bool) {
+            if live, !proven { observe(.witnessed) }
+            let next: Verdict =
+                switch intent {
+                case .off(let why): .impossible(why)
+                case .on:
+                    proven ? .capable : lastFailure != nil ? .impossible(whenFailing) : .unproven
+                case .unreadable:
+                    // A past success does not speak for a switch nobody can
+                    // read; only the capability live NOW does.
+                    live ? .capable : lastFailure != nil ? .impossible(whenFailing) : .unknown
+                }
+            transition(to: next, cause: "evaluate(\(intent))")
+        }
+
+        /// Reality reports. A contradiction is reality disagreeing with the
+        /// standing verdict - exactly what this machine exists to record.
+        public func observe(_ outcome: Outcome) {
+            switch outcome {
+            case .succeeded, .witnessed:
+                if case .impossible(let why) = verdict {
+                    contradiction("\(outcome) while predicted impossible(\(why))")
+                }
+                proven = true
+                lastFailure = nil
+                transition(to: .capable, cause: "observe(\(outcome))")
+            case .failed(let detail):
+                if verdict == .capable {
+                    contradiction("failed while predicted capable: \(detail)")
+                }
+                proven = false
+                lastFailure = detail
+                // Intent is re-read on the next evaluate(); until then the
+                // honest floor for a failure under an on-switch:
+                transition(to: .impossible(whenFailing), cause: "observe(failed)")
+            }
+        }
+
+        private func transition(to next: Verdict, cause: String) {
+            guard next != verdict else { return }
+            record("\(verdict) → \(next)  [\(cause)]")
+            verdict = next
+        }
+
+        private func contradiction(_ line: String) {
+            record("CONTRADICTION: \(line)")
+        }
+
+        private func record(_ line: String) {
+            journal.append((Date(), line))
+            if journal.count > 64 { journal.removeFirst() }
+            log.notice("\(line, privacy: .public)")
+        }
+    }
+}
+
+/// An intent is a value: it crosses actors as freely as its reason does
+/// (an app reads it on a background probe and applies it on the main actor).
+extension PermissionGrant.Claim.Intent: Sendable where Reason: Sendable {}
diff --git a/Sources/PermissionGrants/Notifications.swift b/Sources/PermissionGrants/Notifications.swift
new file mode 100644
index 0000000..10cfb88
--- /dev/null
+++ b/Sources/PermissionGrants/Notifications.swift
@@ -0,0 +1,147 @@
+#if os(macOS) || os(iOS)
+    import UserNotifications
+    #if os(macOS)
+        import AppKit
+    #else
+        import UIKit
+    #endif
+
+    extension PermissionGrant {
+        /// Notifications, the one permission the notification daemon owns
+        /// per bundle rather than tccd.
+        ///
+        /// The reach is a FACT the person changes in Settings at any moment,
+        /// never a value an app keeps: every surface reads it fresh. An app
+        /// that asked once at launch and remembered the answer shows "off"
+        /// after the person turned it on.
+        ///
+        /// macOS: UNUserNotificationCenter only serves a BUNDLED app launched
+        /// in the user's context (LaunchServices). A bare binary or a launchd
+        /// agent cannot ask, read, or post; such a process hands its messages
+        /// to a nested helper app, learns the reach from what the helper
+        /// records, and declares a custom grant whose standing is
+        /// `standing(recorded)` and whose act opens the HELPER's settings.
+        public enum Notifications {
+            /// Whether the person SEES this app's notifications. "Authorized"
+            /// alone lies: an app allowed with every on-screen delivery off,
+            /// or delivered quietly (provisional), posts into a list and
+            /// interrupts nobody, which for a message that matters is denied.
+            public enum Reach: String, Codable, Sendable {
+                /// The system prompt has never been shown. One ask is available.
+                case notAsked
+                /// The person said no. Only Settings can flip it.
+                case denied
+                /// Allowed, but nothing appears where the person looks: alerts
+                /// off (macOS: alert style None; iOS: banners and Lock Screen
+                /// both off), or quiet (provisional) delivery.
+                case silenced
+                /// Banners or alerts reach the screen.
+                case allowed
+            }
+
+            /// Synchronous, for the surfaces' pulse: one XPC round trip.
+            /// nil = no answer within `timeout`, or a status this build does
+            /// not know, which `standing` renders as unknown.
+            public static func reach(timeout: TimeInterval = 2) -> Reach? {
+                final class Answer: @unchecked Sendable { var reach: Reach? }
+                let answer = Answer()
+                let done = DispatchSemaphore(value: 0)
+                UNUserNotificationCenter.current().getNotificationSettings { settings in
+                    answer.reach = reach(of: settings)
+                    done.signal()
+                }
+                guard done.wait(timeout: .now() + timeout) == .success else { return nil }
+                return answer.reach
+            }
+
+            /// The same readout without blocking, for code already async.
+            public static func reach() async -> Reach? {
+                reach(of: await UNUserNotificationCenter.current().notificationSettings())
+            }
+
+            public static func reach(of settings: UNNotificationSettings) -> Reach? {
+                switch settings.authorizationStatus {
+                case .notDetermined: .notAsked
+                case .denied: .denied
+                case .authorized: seen(settings) ? .allowed : .silenced
+                case .provisional, .ephemeral: .silenced
+                @unknown default: nil
+                }
+            }
+
+            /// What "on screen" means per platform. macOS: an alert style that
+            /// draws something. iOS: a banner while the phone is in use, or the
+            /// Lock Screen while it is not.
+            private static func seen(_ settings: UNNotificationSettings) -> Bool {
+                #if os(macOS)
+                    settings.alertSetting == .enabled && settings.alertStyle != .none
+                #else
+                    settings.alertSetting == .enabled || settings.lockScreenSetting == .enabled
+                #endif
+            }
+
+            /// First ask fires the system prompt; after any answer the system
+            /// never prompts again, so asking again opens this app's own
+            /// notification settings.
+            public static func ask(
+                options: UNAuthorizationOptions = [.alert, .sound],
+                bundleID: String = Bundle.main.bundleIdentifier!
+            ) async {
+                guard await reach() == .notAsked else { return openSettings(bundleID: bundleID) }
+                _ = try? await UNUserNotificationCenter.current().requestAuthorization(
+                    options: options)
+            }
+
+            /// The app's notification settings. macOS: System Settings ›
+            /// Notifications scrolled to `bundleID`'s row (a helper that posts
+            /// on another process's behalf passes the HELPER's id: the row
+            /// belongs to whoever posts). iOS: Settings › this app ›
+            /// Notifications (only the calling app's own; `bundleID` unused).
+            public static func openSettings(bundleID: String) {
+                #if os(macOS)
+                    NSWorkspace.shared.open(
+                        URL(
+                            string:
+                                "x-apple.systempreferences:com.apple.Notifications-Settings.extension?id=\(bundleID)"
+                        )!)
+                #else
+                    Task { @MainActor in
+                        UIApplication.shared.open(
+                            URL(string: UIApplication.openNotificationSettingsURLString)!)
+                    }
+                #endif
+            }
+
+            #if os(macOS)
+                static let settingsName = "System Settings"
+                static let system = "macOS"
+                static let silencedNote =
+                    "Allowed, but alerts are off: messages land in Notification Center without appearing."
+            #else
+                static let settingsName = "Settings"
+                static let system = "iOS"
+                static let silencedNote =
+                    "Allowed, but banners and the Lock Screen are both off: messages land in Notification Centre without appearing."
+            #endif
+
+            /// The one derivation from reach to standing, shared by every app
+            /// so no two of them disagree on what a silenced app means.
+            public static func standing(_ reach: Reach?) -> Standing {
+                switch reach {
+                case .allowed: .good
+                case .notAsked: .askable("Allow\u{2026}")
+                case .denied:
+                    .broken(
+                        "Open \(settingsName)\u{2026}",
+                        note:
+                            "Notifications are off in \(settingsName). \(system) never asks twice."
+                    )
+                case .silenced:
+                    .broken("Open \(settingsName)\u{2026}", note: silencedNote)
+                case nil:
+                    .unknown(note: "Notification settings did not answer.")
+                }
+            }
+        }
+    }
+#endif
diff --git a/Sources/PermissionGrants/Observe.swift b/Sources/PermissionGrants/Observe.swift
new file mode 100644
index 0000000..77109d9
--- /dev/null
+++ b/Sources/PermissionGrants/Observe.swift
@@ -0,0 +1,87 @@
+import Foundation
+
+#if os(macOS)
+    import AppKit
+    private let becameActive = NSApplication.didBecomeActiveNotification
+#elseif os(iOS) || os(tvOS)
+    import UIKit
+    private let becameActive = UIApplication.didBecomeActiveNotification
+#endif
+
+extension PermissionGrant {
+    /// The hook: `handler` runs on the main thread with the grant's new
+    /// standing each time it changes (never for an unchanged one, never for
+    /// the current one at registration). No app writes a polling loop.
+    ///
+    /// How a change is noticed, per kind: a Privacy switch through the hub
+    /// (at once, from macOS's own signals and the fresh probe); everything
+    /// macOS does not announce (a background service's approval, a
+    /// notification setting, an app's own state) by one read every 2 s
+    /// while any observer is registered, and at once when the app comes
+    /// forward. Nothing is read once the last observer cancels.
+    @MainActor @discardableResult
+    public func observe(_ handler: @escaping @MainActor (Standing) -> Void) -> Observer {
+        Watch.shared.add(self, handler)
+    }
+
+    /// A registration of `observe`. It lives until `cancel()`, whether or not
+    /// it is kept: a hook an app forgot to keep is still a hook.
+    @MainActor public final class Observer {
+        fileprivate let id = UUID()
+        public func cancel() { Watch.shared.remove(id) }
+    }
+}
+
+/// Every registered hook, read at once on a signal and every 2 s otherwise.
+@MainActor private final class Watch {
+    static let shared = Watch()
+
+    private struct Entry {
+        let grant: PermissionGrant
+        var last: PermissionGrant.Standing
+        let handler: @MainActor (PermissionGrant.Standing) -> Void
+    }
+    private var entries: [UUID: Entry] = [:]
+    private var timer: Timer?
+
+    private init() {
+        #if os(macOS)
+            PrivacyHub.shared.observe { _, _ in
+                MainActor.assumeIsolated { Watch.shared.check() }
+            }
+        #endif
+        NotificationCenter.default.addObserver(
+            forName: becameActive, object: nil, queue: .main
+        ) { _ in MainActor.assumeIsolated { Watch.shared.check() } }
+    }
+
+    func add(
+        _ grant: PermissionGrant, _ handler: @escaping @MainActor (PermissionGrant.Standing) -> Void
+    ) -> PermissionGrant.Observer {
+        let observer = PermissionGrant.Observer()
+        entries[observer.id] = Entry(grant: grant, last: grant.standing, handler: handler)
+        if timer == nil {
+            timer = Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { _ in
+                MainActor.assumeIsolated { Watch.shared.check() }
+            }
+        }
+        return observer
+    }
+
+    func remove(_ id: UUID) {
+        entries[id] = nil
+        if entries.isEmpty {
+            timer?.invalidate()
+            timer = nil
+        }
+    }
+
+    private func check() {
+        for (id, entry) in entries {
+            let now = entry.grant.standing
+            guard now != entry.last else { continue }
+            entries[id]?.last = now
+            entry.handler(now)
+        }
+    }
+}
diff --git a/Sources/PermissionGrants/PermissionGrant.swift b/Sources/PermissionGrants/PermissionGrant.swift
new file mode 100644
index 0000000..9286652
--- /dev/null
+++ b/Sources/PermissionGrants/PermissionGrant.swift
@@ -0,0 +1,239 @@
+import Foundation
+
+#if os(macOS) || os(iOS)
+    import UserNotifications
+#endif
+
+/// One thing the app needs the person, or macOS, to allow: a Privacy &
+/// Security switch, a background service, notifications, or anything of the
+/// app's own. The app declares each ONCE, as a named constant, and that one
+/// name is every screen's row and every line of code's gate, ask and hook:
+///
+///     extension PermissionGrant {
+///         static let microphone = PermissionGrant.privacy(
+///             .microphone, title: "Microphone", why: "Records your side of the call.")
+///     }
+///     PermissionGrant.Section("Permissions", [.microphone])   // a screen
+///     guard await PermissionGrant.microphone.ask() else { … } // code
+///
+/// The module's one top-level name: everything else is nested here, so no
+/// app's own `Grant`, `Permission`, `Standing` or `Claim` can collide.
+public struct PermissionGrant: Sendable {
+    public enum Kind: Sendable {
+        #if os(macOS)
+            /// A switch in System Settings › Privacy & Security.
+            case privacy(Privacy)
+            /// Privacy & Security › Automation: Apple Events to one app.
+            case automation(bundleID: String)
+            /// A process run beside the app through `SMAppService`.
+            case backgroundService(BackgroundService)
+        #endif
+        #if os(macOS) || os(iOS)
+            /// Notifications posted from the app's own process.
+            case notifications(UNAuthorizationOptions)
+        #endif
+        /// The app's own: what it reads, and what the button does. Both run on
+        /// the main thread (they read the app's own state).
+        case custom(
+            standing: @MainActor @Sendable () -> Standing, act: @MainActor @Sendable () -> Void)
+    }
+
+    public let kind: Kind
+    public let title: String
+    /// Why the app needs it, one short line under the title.
+    public let why: String
+    public let symbol: String
+    /// Required gates a feature; optional only enriches one. Drives
+    /// `blocking` and how the shapes group the rows.
+    public let required: Bool
+
+    /// The app's own grant.
+    public init(
+        title: String, why: String, symbol: String, required: Bool = true,
+        standing: @escaping @MainActor @Sendable () -> Standing,
+        act: @escaping @MainActor @Sendable () -> Void
+    ) {
+        self.init(
+            kind: .custom(standing: standing, act: act), title: title, why: why, symbol: symbol,
+            required: required)
+    }
+
+    init(kind: Kind, title: String, why: String, symbol: String, required: Bool) {
+        self.kind = kind
+        self.title = title
+        self.why = why
+        self.symbol = symbol
+        self.required = required
+    }
+
+    #if os(macOS)
+        public static func privacy(
+            _ privacy: Privacy, title: String, why: String, symbol: String? = nil,
+            required: Bool = true
+        ) -> PermissionGrant {
+            PermissionGrant(
+                kind: .privacy(privacy), title: title, why: why, symbol: symbol ?? privacy.symbol,
+                required: required)
+        }
+
+        public static func automation(
+            of bundleID: String, title: String, why: String, symbol: String = "applescript",
+            required: Bool = true
+        ) -> PermissionGrant {
+            PermissionGrant(
+                kind: .automation(bundleID: bundleID), title: title, why: why, symbol: symbol,
+                required: required)
+        }
+
+        public static func backgroundService(
+            _ service: BackgroundService, title: String, why: String,
+            symbol: String = "gearshape.2", required: Bool = true
+        ) -> PermissionGrant {
+            PermissionGrant(
+                kind: .backgroundService(service), title: title, why: why, symbol: symbol,
+                required: required)
+        }
+    #endif
+
+    #if os(macOS) || os(iOS)
+        public static func notifications(
+            title: String = "Notifications", why: String, symbol: String = "bell.badge",
+            required: Bool = false, options: UNAuthorizationOptions = [.alert, .sound]
+        ) -> PermissionGrant {
+            PermissionGrant(
+                kind: .notifications(options), title: title, why: why, symbol: symbol,
+                required: required)
+        }
+    #endif
+
+    // MARK: Reading
+
+    /// What every surface renders, read fresh on each access: the one place
+    /// a raw status becomes presentation.
+    public var standing: Standing {
+        switch kind {
+        #if os(macOS)
+            case .privacy(let privacy): PrivacyHub.shared.standing(privacy)
+            case .automation(let bundleID): Automation.standing(of: bundleID)
+            case .backgroundService(let service): service.standing(title: title)
+        #endif
+        #if os(macOS) || os(iOS)
+            case .notifications: Notifications.standing(Notifications.reach())
+        #endif
+        case .custom(let standing, _): MainActor.assumeIsolated { standing() }
+        }
+    }
+
+    /// The gate: the app may do what this grant is for, right now.
+    public var isAllowed: Bool { standing.grade == .good }
+
+    /// THE banner/preflight predicate: a required grant the person must fix.
+    /// Optional grants never block anything.
+    public var blocking: Bool { required && standing.grade == .broken }
+
+    // MARK: Asking
+
+    /// The standing's button: asks, opens the right Settings, or reopens.
+    @MainActor public func act() {
+        Task { _ = await ask() }
+    }
+
+    /// Asks the way this grant asks (the prompt, Settings, Login Items, a
+    /// reopen) and answers whether it is allowed once the person answered.
+    /// Where macOS answers in System Settings instead of a prompt, it returns
+    /// at once; `observe` reports the switch when it flips.
+    @discardableResult
+    @MainActor public func ask() async -> Bool {
+        switch kind {
+        #if os(macOS)
+            case .privacy(let privacy): await PrivacyHub.shared.ask(privacy)
+            case .automation(let bundleID): await Automation.ask(bundleID)
+            case .backgroundService(let service): service.act(title: title)
+        #endif
+        #if os(macOS) || os(iOS)
+            case .notifications(let options): await Notifications.ask(options: options)
+        #endif
+        case .custom(_, let act): act()
+        }
+        return isAllowed
+    }
+
+    #if os(macOS)
+        /// Turns a background service off (a login item the person
+        /// unchecks): the reverse of `ask`, idempotent. Only a background
+        /// service can be withdrawn by the app.
+        public func unregister() {
+            guard case .backgroundService(let service) = kind else {
+                preconditionFailure("\(title): only a background service unregisters")
+            }
+            service.unregister(title: title)
+        }
+
+        /// First thing in an app's `main`: a launch as the hub's fresh probe
+        /// answers and exits. Without it a Privacy & Security change shows
+        /// only when the app reopens.
+        public static func answerProbeIfAsked() { PrivacyHub.answerProbeIfAsked() }
+    #endif
+}
+
+extension PermissionGrant {
+    /// The ONE user-facing answer for a grant, presentation riding the state.
+    ///
+    /// THE LAW this type exists to enforce: a surface renders a Standing
+    /// mechanically (grade → checkmark or button, `actionTitle` on the button,
+    /// `note` under the title) and NEVER re-derives "is this a problem?" from
+    /// anything rawer. Two surfaces answering that question with their own
+    /// thresholds is the split-brain bug, and with Standing as the only
+    /// readable vocabulary it is unwritable. An enum so the invalid states (a
+    /// good with an action, a broken without its fix) are unrepresentable.
+    public enum Standing: Equatable, Sendable {
+        /// Granted, and the app can SEE that it is. Checkmark; no surface
+        /// warns, no banner, no note.
+        case good
+        /// Not yet granted, one click asks. An OFFER, never a failure:
+        /// onboarding and settings present it, nothing warns about it.
+        case askable(_ actionTitle: String, note: String? = nil)
+        /// The person must fix something outside the app. EVERY surface warns
+        /// with this same note and action.
+        case broken(_ actionTitle: String, note: String)
+        /// The app CANNOT READ whether this is granted, and nothing has
+        /// contradicted it: a quiet "unknown", no checkmark, no button, the
+        /// note saying why. Never warns, never blocks, never asks.
+        case unknown(note: String)
+
+        /// The payload-free shape, for the comparisons surfaces live on
+        /// (`grade == .broken`, `grade.needsUser`).
+        public enum Grade: Equatable, Sendable {
+            case good, askable, broken, unknown
+
+            /// Something for the person to DO: ask, or fix.
+            public var needsUser: Bool { self == .askable || self == .broken }
+        }
+
+        public var grade: Grade {
+            switch self {
+            case .good: .good
+            case .askable: .askable
+            case .broken: .broken
+            case .unknown: .unknown
+            }
+        }
+
+        /// Rendered only for the grades with a button (`askable`, `broken`).
+        public var actionTitle: String {
+            switch self {
+            case .good, .unknown: ""
+            case .askable(let title, _), .broken(let title, note: _): title
+            }
+        }
+
+        public var note: String? {
+            switch self {
+            case .good: nil
+            case .askable(_, let note): note
+            case .broken(_, let note): note
+            case .unknown(let note): note
+            }
+        }
+    }
+}
